root = true

[*.json]
indent_style = space
indent_size = 4
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.nix]
indent_style = space
indent_size = 2
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.lua]
max_line_length = 120
indent_style = space
indent_size = 2
tab_width = 8
end_of_line = lf
insert_final_newline = true

